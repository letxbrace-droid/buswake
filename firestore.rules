rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----- Helpers -----
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Compte administrateur (toi) : droits de maintenance (nettoyage global).
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'letxbrace@gmail.com';
    }

    // Validation du document utilisateur écrit par son propriétaire.
    // Ceinture-bretelles contre la fuite de mot de passe dans le pseudo :
    //  - le pseudo doit être une chaîne de 1 à 24 caractères (le formulaire
    //    limite déjà à 20) ;
    //  - le pseudo ne doit jamais être égal à l'email du compte.
    // Les règles ne peuvent pas comparer au mot de passe Auth (non lisible),
    // donc la longueur + le garde-fou côté client restent la protection.
    function validUserData() {
      let d = request.resource.data;
      return (!('pseudo' in d) || (
                d.pseudo is string &&
                d.pseudo.size() >= 1 &&
                d.pseudo.size() <= 24 &&
                (!('email' in d) || d.pseudo != d.email)
              ))
             && (!('email' in d) || d.email is string)
             && (!('xp' in d) || d.xp is number);
    }

    // Champs qu'un AUTRE joueur a le droit de modifier (gamification + social) :
    // XP/badges/stats lors de la fin d'un match, demandes/listes d'amis.
    // Les champs sensibles (pseudo, email, atouts, poste...) restent réservés
    // au propriétaire du compte.
    function onlyGamificationAndSocial() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['xp', 'badges', 'stats', 'noteSum', 'noteCount',
                  'presences', 'lapins', 'streak',
                  'friends', 'friendRequestsSent', 'friendRequestsReceived']);
    }

    // Utilisateurs : lecture pour les connectés (classement).
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && validUserData();
      // Le propriétaire modifie tout son doc (avec validation du pseudo).
      allow update: if isOwner(uid) && validUserData();
      // Les autres joueurs ne touchent QUE la gamification et le social.
      allow update: if isSignedIn() && onlyGamificationAndSocial();
      allow delete: if isOwner(uid);
    }

    // ----- Matchs -----
    // Deux niveaux d'écriture :
    //  - le CRÉATEUR (ou l'admin, ou tout connecté pour les anciens matchs
    //    sans créateur) gère le cycle de vie : confirmation, équipes,
    //    scores, présence, ajout/retrait de joueurs ;
    //  - les AUTRES joueurs ne touchent qu'aux champs de PARTICIPATION :
    //    votes, inscription/désistement (avec promotion auto du banc),
    //    notes entre joueurs, vote homme du match.
    // Les champs sensibles (statut, scores, équipes, date/lieu finals,
    // créateur) sont donc hors de portée d'un joueur lambda.
    // Les marqueurs _notifs sont écrits par les Cloud Functions (Admin SDK,
    // qui contourne ces règles) — aucun client n'a besoin d'y toucher.

    // Vrai si l'appelant gère ce match (créateur / admin / match hérité).
    function managesMatch() {
      return isAdmin()
        || !('createurUid' in resource.data)
        || resource.data.createurUid == request.auth.uid;
    }
    // L'update ne touche qu'aux champs de participation, avec des tailles
    // saines (10 titulaires + banc ; large marge à 30).
    function onlyParticipation() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['votes', 'joueursInscrits', 'waitlist',
                              'ratings', 'motmVotes'])
        && request.resource.data.get('joueursInscrits', []).size() <= 30
        && request.resource.data.get('waitlist', []).size() <= 30
        // Un joueur n'écrit que SA fiche de notes (ratings.{son uid}).
        && (!changed.hasAny(['ratings'])
            || request.resource.data.ratings
                 .diff(resource.data.get('ratings', {}))
                 .affectedKeys().hasOnly([request.auth.uid]));
    }

    match /matchs/{matchId} {
      // Lecture d'UN match par son identifiant : tout connecté.
      // C'est ce qui fait marcher le lien d'invitation — un match « sur
      // invitation » est NON RÉFÉRENCÉ (il ne remonte dans aucun fil), pas
      // secret : qui détient le lien peut l'ouvrir. Même modèle qu'une
      // vidéo non répertoriée. Ne jamais y mettre de donnée sensible.
      allow get: if isSignedIn();
      // Lecture d'une LISTE : chaque document renvoyé doit être autorisé,
      // sinon Firestore refuse la requête entière. Résultat : un fil ne
      // peut ramener que du public, ou mes propres matchs. Les matchs
      // hérités (sans le champ) sont traités comme publics.
      allow list: if isSignedIn() && (
           resource.data.get('visibilite', 'public') == 'public'
        || request.auth.uid in resource.data.get('joueursInscrits', [])
        || resource.data.get('createurUid', '') == request.auth.uid);
      // Création : on ne crée qu'en son propre nom, toujours en sondage.
      // Le mot du créateur (message) est optionnel et borné à 200 caractères.
      allow create: if isSignedIn()
        && request.resource.data.createurUid == request.auth.uid
        && request.resource.data.statut == 'sondage'
        && (!('message' in request.resource.data)
            || request.resource.data.message == null
            || (request.resource.data.message is string
                && request.resource.data.message.size() <= 200))
        // Visibilité : uniquement les deux valeurs que le produit connaît.
        && request.resource.data.get('visibilite', 'public') in ['public', 'prive']
        // Effectif : borné. Sans plafond, un match à 10 000 places ferait
        // exploser les listes et les notifications côté serveur.
        && (!('joueursMax' in request.resource.data)
            || (request.resource.data.joueursMax is int
                && request.resource.data.joueursMax >= 2
                && request.resource.data.joueursMax <= 40));
      // Gestion complète par le créateur — sans transfert de propriété,
      // et avec un statut toujours valide.
      allow update: if isSignedIn() && managesMatch()
        && request.resource.data.get('createurUid', null)
             == resource.data.get('createurUid', null)
        && request.resource.data.statut in ['sondage', 'confirmé', 'terminé'];
      // Participation par les autres joueurs.
      allow update: if isSignedIn() && onlyParticipation();
      // Suppression : le créateur, l'admin (maintenance), ou tout connecté
      // pour les anciens matchs sans créateur enregistré (données héritées).
      allow delete: if isSignedIn()
        && (isAdmin()
            || !('createurUid' in resource.data)
            || resource.data.createurUid == request.auth.uid);
    }

    // Chat éphémère par match : texte court, créé par son auteur.
    match /matchs/{matchId}/messages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ----- ÉQUIPES -----
    // Une équipe est publique en lecture : on doit pouvoir en découvrir une
    // pour la rejoindre ou la défier. Deux écritures seulement sont permises :
    // le capitaine gère son équipe, et un joueur ajoute ou retire SA propre
    // présence de l'effectif. Rien d'autre.
    function equipeValide() {
      let d = request.resource.data;
      return d.nom is string && d.nom.size() >= 2 && d.nom.size() <= 28
        && d.capitaineUid is string
        && d.sport is string
        && d.niveau in ['debutant', 'intermediaire', 'confirme']
        && d.membres is list && d.membres.size() >= 1 && d.membres.size() <= 20
        && (!('description' in d) || d.description == null ||
            (d.description is string && d.description.size() <= 160))
        && (!('appel' in d) || d.appel == null ||
            (d.appel is string && d.appel.size() <= 120))
        // L'emblème est un identifiant de tracé, pas une URL : on le borne
        // à la liste connue, sinon n'importe quelle chaîne finirait dans un
        // attribut SVG côté client.
        && (!('embleme' in d) || d.embleme == null || d.embleme in [
             'eclair','couronne','etoile','flamme','griffe','ancre','fleche',
             'tour','cible','vague','montagne','diamant','ballon','croix'])
        && (!('couleur' in d) || d.couleur == null || d.couleur in [
             '#00D88A','#00B0FF','#FF8A3D','#B36BFF','#FFD24A','#FF5A6E'])
        // Club de cœur : un identifiant du catalogue, pas une URL libre.
        && (!('club' in d) || d.club == null || d.club in [
             'psg','om','ol','monaco','barca','real','bayern','city','liverpool','chelsea'])
        && (!('clubEcusson' in d) || d.clubEcusson is bool);
    }
    // Un joueur ne peut modifier QUE le tableau `membres`, et uniquement en y
    // ajoutant ou retirant son propre uid. Il ne peut ni renommer l'équipe,
    // ni toucher aux statistiques, ni inscrire quelqu'un d'autre.
    function rejointOuQuitte() {
      let d = request.resource.data;
      let o = resource.data;
      let moi = request.auth.uid;
      return d.diff(o).affectedKeys().hasOnly(['membres'])
        && (
          (d.membres.size() == o.membres.size() + 1
            && d.membres.hasAll(o.membres) && moi in d.membres && !(moi in o.membres))
          ||
          (d.membres.size() == o.membres.size() - 1
            && o.membres.hasAll(d.membres) && moi in o.membres && !(moi in d.membres))
        );
    }
    match /equipes/{equipeId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.capitaineUid == request.auth.uid
        && request.auth.uid in request.resource.data.membres
        && equipeValide();
      allow update: if isSignedIn() && (
           (resource.data.capitaineUid == request.auth.uid && equipeValide())
        || rejointOuQuitte()
      );
      allow delete: if isSignedIn()
        && (resource.data.capitaineUid == request.auth.uid || isAdmin());
    }

    // ----- DÉFIS -----
    // Un défi lie DEUX équipes. Il est lisible par tout connecté (les deux
    // camps doivent le voir), créé par le capitaine de l'équipe qui défie,
    // et la seule réponse permise est celle du capitaine défié : accepter
    // ou refuser. Personne ne peut réécrire un défi déjà tranché.
    function defiValide() {
      let d = request.resource.data;
      return d.equipeA is string && d.equipeB is string && d.equipeA != d.equipeB
        && d.capitaineA is string && d.capitaineB is string
        && d.sport is string
        && d.lieu is string && d.lieu.size() >= 2 && d.lieu.size() <= 80
        && d.statut in ['envoye', 'accepte', 'refuse']
        && (!('message' in d) || d.message == null ||
            (d.message is string && d.message.size() <= 140));
    }
    match /defis/{defiId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.capitaineA == request.auth.uid
        && request.resource.data.statut == 'envoye'
        && defiValide();
      // Seul le capitaine défié répond, et seulement à un défi en attente.
      // Il ne peut changer QUE le statut (et le match qui en découle) :
      // ni la date, ni le lieu, ni les équipes.
      allow update: if isSignedIn()
        && resource.data.statut == 'envoye'
        && resource.data.capitaineB == request.auth.uid
        && request.resource.data.statut in ['accepte', 'refuse']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['statut', 'matchId', 'repondUAt']);
      // L'équipe qui a lancé le défi peut le retirer tant qu'il est en attente.
      allow delete: if isSignedIn()
        && (isAdmin() || (resource.data.capitaineA == request.auth.uid
                          && resource.data.statut == 'envoye'));
    }

    // Lieux : lecture pour tous les connectés, écriture via Admin SDK only.
    match /lieux/{lieuId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
